<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <packaging>pom</packaging>

    <groupId>com.xs</groupId>
    <artifactId>xs-net-workspace</artifactId>
    <version>0.0.1-SNAPSHOT</version>

    <name>xs-net-workspace</name>
    <description>XS-NET Java game server framework and example workspace.</description>
    <url>https://gitee.com/xs-gitee-2023/xs-net</url>

    <scm>
        <connection>scm:git:https://gitee.com/xs-gitee-2023/xs-net.git</connection>
        <developerConnection>scm:git:ssh://git@gitee.com:xs-gitee-2023/xs-net.git</developerConnection>
        <url>https://gitee.com/xs-gitee-2023/xs-net</url>
    </scm>

    <issueManagement>
        <system>Gitee Issues</system>
        <url>https://gitee.com/xs-gitee-2023/xs-net/issues</url>
    </issueManagement>

    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <!-- Keep xs-net and game-server in one reactor. -->
    <modules>
        <module>xs-net</module>
        <module>game-server</module>
    </modules>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <java.version>21</java.version>
    </properties>
</project>
