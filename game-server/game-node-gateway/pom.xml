<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.xs</groupId>
        <artifactId>game-server</artifactId>
        <version>0.0.1-SNAPSHOT</version>
    </parent>
    <artifactId>game-node-gateway</artifactId>
    <name>game-gateway</name>
    <description>Game Gateway Service</description>
    <dependencies>
        <dependency>
            <groupId>com.xs</groupId>
            <artifactId>game-comment</artifactId>
            <version>0.0.1-SNAPSHOT</version>
        </dependency>
        <!-- 显式依赖：网关直接引用 com.game.message.*（NetMessage DTO / RPC 路由表） -->
        <dependency>
            <groupId>com.xs</groupId>
            <artifactId>game-message-action</artifactId>
            <version>0.0.1-SNAPSHOT</version>
        </dependency>
        <dependency>
            <groupId>com.xs</groupId>
            <artifactId>xs-net-transport</artifactId>
            <version>0.0.1</version>
        </dependency>

        <!-- Pekko Cluster dependencies -->
        <!-- Classic Pekko API -->
        <!-- Pekko Cluster - 提供Pekko集群支持，用于节点管理和通信 -->
        <dependency>
            <groupId>org.apache.pekko</groupId>
            <artifactId>pekko-cluster_2.13</artifactId>
            <version>${pekko.version}</version>
        </dependency>
        <!-- Pekko Remote - 提供Pekko远程通信支持，用于节点间消息传递 -->
        <dependency>
            <groupId>org.apache.pekko</groupId>
            <artifactId>pekko-remote_2.13</artifactId>
            <version>${pekko.version}</version>
        </dependency>
        <!-- Pekko SLF4J - 提供Pekko日志与SLF4J的集成，用于日志记录 -->
        <dependency>
            <groupId>org.apache.pekko</groupId>
            <artifactId>pekko-slf4j_2.13</artifactId>
            <version>${pekko.version}</version>
        </dependency>
        
        <!-- Pekko Serialization - 提供Pekko序列化支持 -->
        <dependency>
            <groupId>org.apache.pekko</groupId>
            <artifactId>pekko-serialization-jackson_2.13</artifactId>
            <version>${pekko.version}</version>
        </dependency>
        
        <!-- Protobuf Dependencies - 用于Protocol Buffers序列化 -->
        <dependency>
            <groupId>com.google.protobuf</groupId>
            <artifactId>protobuf-java</artifactId>
            <version>${protobuf-java.version}</version>
        </dependency>

        <!-- Netty - 提供 TCP 长连接通信，承载客户端游戏消息与 S2C 下行 -->
        <dependency>
            <groupId>io.netty</groupId>
            <artifactId>netty-all</artifactId>
            <version>4.1.115.Final</version>
        </dependency>
        
        <!-- Typed Pekko API -->
        <!-- Pekko Actor Typed - 提供Pekko类型化Actor支持，用于构建类型安全的Actor系统 -->
        <dependency>
            <groupId>org.apache.pekko</groupId>
            <artifactId>pekko-actor-typed_2.13</artifactId>
            <version>${pekko.version}</version>
        </dependency>
        <!-- Pekko Cluster Typed - 提供类型化Pekko集群支持，用于构建类型安全的集群应用 -->
        <dependency>
            <groupId>org.apache.pekko</groupId>
            <artifactId>pekko-cluster-typed_2.13</artifactId>
            <version>${pekko.version}</version>
        </dependency>
        <!-- Pekko Cluster Sharding Typed - 提供类型化Pekko集群分片支持，用于分布式实体管理 -->
        <dependency>
            <groupId>org.apache.pekko</groupId>
            <artifactId>pekko-cluster-sharding-typed_2.13</artifactId>
            <version>${pekko.version}</version>
        </dependency>
        
        <!-- Aeron媒体驱动 - 提供高性能UDP传输支持，用于Pekko Artery的Aeron UDP模式 -->
        <dependency>
            <groupId>io.aeron</groupId>
            <artifactId>aeron-driver</artifactId>
        </dependency>

        <!-- Actuator - 提供健康检查 / 可观测性端点 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <!-- WebMVC - 承载 Actuator 管理端点（/actuator/health 等） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>
        <!-- Micrometer Prometheus registry - 暴露 /actuator/prometheus 指标 -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>

        <!-- Spring Boot Test - 提供Spring Boot测试支持，包括JUnit、Mockito等 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <mainClass>com.game.GameGatewayApplication</mainClass>
                    <jvmArguments>
                    --add-opens java.base/sun.nio.ch=ALL-UNNAMED
                    --add-opens java.base/java.nio=ALL-UNNAMED
                </jvmArguments>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
