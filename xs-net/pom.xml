<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.xs</groupId>
    <artifactId>xs-net</artifactId>
    <version>0.0.1</version>

    <packaging>pom</packaging>
    <description>
        pekko + netty + proto  游戏服务器框架
    </description>

    <name>xs-net</name>
    <url>https://gitee.com/xs-gitee-2023/xs-net</url>

    <scm>
        <connection>scm:git:https://gitee.com/xs-gitee-2023/xs-net.git</connection>
        <developerConnection>scm:git:ssh://git@gitee.com:xs-gitee-2023/xs-net.git</developerConnection>
        <url>https://gitee.com/xs-gitee-2023/xs-net</url>
    </scm>

    <issueManagement>
        <system>Gitee Issues</system>
        <url>https://gitee.com/xs-gitee-2023/xs-net/issues</url>
    </issueManagement>

    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <modules>
        <module>xs-net-tools</module>
        <module>xs-net-message</module>
        <module>xs-net-kernel</module>
        <module>xs-net-transport</module>
        <module>xs-net-rpc-maven-plugin</module>
        <module>xs-net-sdk</module>
        <module>xs-net-all</module>
    </modules>

    <properties>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <java.version>21</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>


        <pekko.version>1.1.5</pekko.version>

        <aeron.version>1.40.0</aeron.version>
        <commons-io.version>2.16.1</commons-io.version>
        <commons-lang3.version>3.18.0</commons-lang3.version>
        <gson.version>2.10.1</gson.version>
        <javaparser.version>3.26.3</javaparser.version>
        <lombok.version>1.18.34</lombok.version>
        <lmdbjava.version>0.8.3</lmdbjava.version>
        <logback.version>1.5.26</logback.version>
        <maven-plugin-api.version>3.9.9</maven-plugin-api.version>
        <maven-plugin-annotations.version>3.13.1</maven-plugin-annotations.version>
        <micrometer.version>1.16.0</micrometer.version>
        <mybatis-plus.version>3.5.4.1</mybatis-plus.version>
        <mockito.version>5.20.0</mockito.version>
        <protobuf.version>3.25.5</protobuf.version>
        <slf4j-api.version>2.0.16</slf4j-api.version>
        <junit4.version>4.13.2</junit4.version>
        <junit5.version>5.11.4</junit5.version>
        <spring.version>7.0.1</spring.version>
        <spring-boot.version>4.0.0</spring-boot.version>
        <velocity.version>2.3</velocity.version>
        <xs-net-rpc-maven-plugin.version>0.0.6</xs-net-rpc-maven-plugin.version>
    </properties>
    <dependencyManagement>
