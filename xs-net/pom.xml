<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.xs</groupId>
    <artifactId>xs-net</artifactId>
    <version>0.0.1</version>

    <packaging>pom</packaging>
    <description>
        akka + netty + proto  游戏服务器框架
    </description>

    <name>xs-net</name>

    <modules>
        <module>xs-net-tools</module>
        <module>xs-net-message</module>
        <module>xs-net-core</module>
        <module>xs-net-all</module>
    </modules>

    <properties>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <java.version>21</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>


        <akka.version>2.8.5</akka.version>
        <sbe.version>1.27.0</sbe.version>

        <lombok.version>1.18.34</lombok.version>
        <slf4j-api.version>2.0.16</slf4j-api.version>
        <logback.version>1.5.26</logback.version>
        <junit.version>4.13.2</junit.version>

        <spring.version>7.0.1</spring.version>
    </properties>
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.xs</groupId>
                <artifactId>tool-all</artifactId>
                <version>${project.version}</version>
            </dependency>

            <!-- Akka Bill of Materials (BOM) - 统一管理所有Akka组件的版本 -->
            <dependency>
                <groupId>com.typesafe.akka</groupId>
                <artifactId>akka-bom_2.13</artifactId>
                <version>${akka.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- Aeron媒体驱动 - 提供高性能UDP传输支持，用于Akka Artery的Aeron UDP模式 -->
            <dependency>
                <groupId>io.aeron</groupId>
                <artifactId>aeron-driver</artifactId>
                <version>1.40.0</version>
            </dependency>

            <!-- LMDB Java绑定 - 用于Akka分布式数据持久化 -->
            <dependency>
                <groupId>org.lmdbjava</groupId>
                <artifactId>lmdbjava</artifactId>
                <version>0.8.3</version>
            </dependency>

            <!-- SBE (Simple Binary Encoding) - 提供高性能的二进制序列化 -->
            <dependency>
                <groupId>uk.co.real-logic</groupId>
                <artifactId>sbe-all</artifactId>
                <version>${sbe.version}</version>
            </dependency>

            <dependency>
                <groupId>org.projectlombok</groupId>
                <artifactId>lombok</artifactId>
                <version>${lombok.version}</version>
            </dependency>

            <dependency>
                <groupId>org.springframework</groupId>
                <artifactId>spring-beans</artifactId>
                <version>${spring.version}</version>
            </dependency>
            <dependency>
                <groupId>org.springframework</groupId>
                <artifactId>spring-context</artifactId>
                <version>${spring.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>
</project>
